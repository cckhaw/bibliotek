{
  "name": "bibliotek",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file=.env scripts/prisma-owner.mjs migrate dev",
    "db:deploy": "node --env-file=.env scripts/prisma-owner.mjs migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:reset": "node --env-file=.env scripts/prisma-owner.mjs migrate reset",
    "test:int": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.int.config.mts",
    "job": "node --env-file=.env --import tsx scripts/run-job.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "^15.5.27",
    "nodemailer": "^10.0.16",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
