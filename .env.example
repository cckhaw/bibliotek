# --- Database -----------------------------------------------------------------------------------
# Runtime, tenant-scoped connection. MUST be a NON-owner role so Postgres Row-Level Security applies.
DATABASE_URL="postgresql://bibliotek_app:bibliotek_app@localhost:5432/bibliotek"
# Owner role: used by migrations/seed (DATABASE_URL_OWNER) and by login, tenant lookup, super-admin and cron
# fan-out (SYSTEM_DATABASE_URL). Bypasses RLS by ownership. Keep these two out of any tenant-facing code path.
DATABASE_URL_OWNER="postgresql://bibliotek:bibliotek@localhost:5432/bibliotek"
SYSTEM_DATABASE_URL="postgresql://bibliotek:bibliotek@localhost:5432/bibliotek"

# --- Auth / app ---------------------------------------------------------------------------------
AUTH_SECRET="generate-with: openssl rand -base64 48"
APP_URL="http://localhost:3000"

# --- Platform super admin -----------------------------------------------------------------------
# On every server start this account is created (or its password updated) so you never need SQL to log in.
# Both must be set. Password: 12+ characters. Optional display name via SUPERADMIN_NAME.
SUPERADMIN_EMAIL="you@yourcompany.com"
SUPERADMIN_PASSWORD="choose-a-long-random-password"
# SUPERADMIN_NAME="Platform Operator"

# --- Background jobs ----------------------------------------------------------------------------
# Bearer token required by /api/jobs/*  (Vercel Cron sends it automatically when CRON_SECRET is set)
CRON_SECRET="generate-with: openssl rand -hex 24"

# --- Email --------------------------------------------------------------------------------------
# Unset = emails are rendered and logged to the console.
# SMTP_URL="smtps://user:password@smtp.example.com:465"
MAIL_FROM="Bibliotek <no-reply@example.com>"
